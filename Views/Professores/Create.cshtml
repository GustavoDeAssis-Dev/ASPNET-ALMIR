@model CodeBuddies.Models.Professor
@{ ViewData["Title"] = "Cadastrar Professor"; }

<section class="cb-form-card">
  <div class="cb-form-head">
    <h1>Cadastrar Professor</h1>
  </div>
  <form asp-action="Create" method="post">
    
    <div class="cb-form-group">
      <label asp-for="Nome" class="cb-form-label"></label>
      <input asp-for="Nome" class="form-control" />
      <span asp-validation-for="Nome" class="cb-validation"></span>
    </div>
    <div class="cb-form-actions">
      <button class="cb-btn cb-btn-primary" type="submit">Salvar</button>
      <a class="cb-btn cb-btn-secondary" asp-action="Index">Voltar</a>
    </div>
  </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }