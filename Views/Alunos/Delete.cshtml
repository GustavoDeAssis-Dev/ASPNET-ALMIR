@model CodeBuddies.Models.Aluno
@{ ViewData["Title"] = "Excluir"; }

<section class="cb-delete-card">
  <div class="cb-delete-head">
    <h1>Excluir Aluno</h1>
  </div>
  <div class="cb-warning">Confirma a exclusão deste registro?</div>
  <dl class="cb-detail-list">
    <div class="cb-detail-row"><dt>ID</dt><dd>@Model.Id</dd></div>
    <div class="cb-detail-row"><dt>@Html.DisplayNameFor(model => model.Nome)</dt><dd>@Html.DisplayFor(model => model.Nome)</dd></div>
    <div class="cb-detail-row"><dt>@Html.DisplayNameFor(model => model.Idade)</dt><dd>@Html.DisplayFor(model => model.Idade)</dd></div>
    <div class="cb-detail-row"><dt>@Html.DisplayNameFor(model => model.ProfessorId)</dt><dd>@Html.DisplayFor(model => model.ProfessorId)</dd></div>
  </dl>
  <form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" />
    <div class="cb-form-actions" style="justify-content:center;">
      <button class="cb-btn cb-btn-danger" type="submit">Excluir</button>
      <a class="cb-btn cb-btn-secondary" asp-action="Index">Cancelar</a>
    </div>
  </form>
</section>