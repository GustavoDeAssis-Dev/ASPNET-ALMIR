@model CodeBuddies.Models.Ranking
@{ ViewData["Title"] = "Detalhes"; }

<section class="cb-detail-card">
  <div class="cb-detail-head">
    <h1>Detalhes — Ranking</h1>
  </div>
  <dl class="cb-detail-list">
    <div class="cb-detail-row"><dt>ID</dt><dd>@Model.Id</dd></div>
    <div class="cb-detail-row"><dt>@Html.DisplayNameFor(model => model.AlunoId)</dt><dd>@Html.DisplayFor(model => model.AlunoId)</dd></div>
    <div class="cb-detail-row"><dt>@Html.DisplayNameFor(model => model.Pontos)</dt><dd>@Html.DisplayFor(model => model.Pontos)</dd></div>
    <div class="cb-detail-row"><dt>@Html.DisplayNameFor(model => model.Estrelas)</dt><dd>@Html.DisplayFor(model => model.Estrelas)</dd></div>
  </dl>
  <div class="cb-form-actions">
    <a class="cb-btn cb-btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    <a class="cb-btn cb-btn-secondary" asp-action="Index">Voltar</a>
  </div>
</section>