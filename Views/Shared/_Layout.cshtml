<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CodeBuddies</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="cb-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container cb-nav">
            <a class="navbar-brand cb-brand" asp-controller="Home" asp-action="Index">
                <span class="cb-brand-code">&lt;/&gt;</span><span>CODE</span><strong>BUDDIES</strong>
            </a>
            <button class="navbar-toggler cb-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="menu" class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto align-items-lg-center cb-menu">
                    <li class="nav-item"><a class="nav-link" asp-controller="Professores" asp-action="Index">Professores</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Alunos" asp-action="Index">Alunos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="FasesJogo" asp-action="Index">Fases do Jogo</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Progressos" asp-action="Index">Progressos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Rankings" asp-action="Index">Rankings</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="cb-main">
    @RenderBody()
</main>

<footer class="cb-footer">
    <div class="container">
        <span>CodeBuddies</span>
        <span>ASP.NET Core MVC + Entity Framework Core</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
